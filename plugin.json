{
  "$schema": "./plugin.schema.json",
  "id": "io.github.youxikong.bangumi",
  "name": "Bangumi",
  "version": "0.0.1",
  "api": 1,
  "description": "从 Bangumi.tv 搜索书籍元数据",
  "author": "Youxikong",
  "icon": "database",
  "capabilities": {
    "metadata": {
      "fields": [
        "title",
        "authors",
        "tags",
        "publisher",
        "pubdate",
        "identifiers",
        "cover",
        "description"
      ]
    }
  },
  "permissions": {
    "hosts": ["api.bgm.tv", "*.bgm.tv", "bangumi.tv"],
    "library": "read"
  },
  "settings": [
    {
      "key": "search_limit",
      "title": "搜索主条目结果数量",
      "type": "number",
      "default": "5",
      "description": "搜索时最多返回多少个结果，过少可能找不到正确条目，过多可能影响性能。"
    },
    {
      "key": "filter_number",
      "title": "过滤后的最大结果数量",
      "type": "number",
      "default": "10",
      "description": "过滤并排序后最多保留多少个结果。"
    },
    {
      "key": "tag_user_count",
      "title": "有效标签的最小打标签人数",
      "type": "number",
      "default": "5",
      "description": "标签至少需要达到多少人标记，才会被认为有效。"
    },
    {
      "key": "tag_count",
      "title": "最大标签数量",
      "type": "number",
      "default": "10",
      "description": "每个条目最多保留多少个标签。"
    }
  ]
}
